# ════════════════════════════════════════════════════════════════════════════════
# SOUNDLOG - Archivo de ejemplo de variables de entorno
# 
# IMPORTANTE: 
# 1. Copiar a .env y actualizar valores
# 2. NUNCA commitear .env a git (incluir en .gitignore)
# 3. En producción usar Azure Key Vault o GitHub Secrets
# ════════════════════════════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 SEGURIDAD CRÍTICA (CAMBIAR ANTES DE PRODUCCIÓN)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Clave secreta para firmar JWT
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mínimo 32 caracteres para producción
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-chars

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌍 ENTORNO
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Ambiente: development, staging, production
ENVIRONMENT=development

# Modo debug (DEBE ser False en producción)
DEBUG=True

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📊 DATABASE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# SQL Server con pyodbc
# Formato: mssql+pyodbc://usuario:contraseña@servidor/basedatos?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=mssql+pyodbc://sa:YourPassword123!@localhost/soundlog?driver=ODBC+Driver+17+for+SQL+Server

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔗 CORS - Orígenes permitidos
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# En desarrollo: localhost
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🎵 SPOTIFY API (AÑADE TUS LLAVES AQUÍ)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Obtén estas llaves en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=TU_CLIENT_ID_AQUI
SPOTIFY_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔑 TOKENS JWT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Expiración del access token en minutos (30 minutos por defecto)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Expiración del refresh token en días (7 días por defecto)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 POLÍTICAS DE CONTRASEÑA
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Longitud mínima de contraseña
MIN_PASSWORD_LENGTH=8

# Requerir mayúscula en contraseña
REQUIRE_UPPERCASE=True

# Requerir número en contraseña
REQUIRE_NUMBERS=True

# Requerir carácter especial en contraseña
REQUIRE_SPECIAL=True

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚫 RATE LIMITING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Límite de requests por minuto por IP
RATE_LIMIT_REQUESTS=100

# Máximo número de intentos fallidos de login antes de bloqueo
MAX_FAILED_LOGIN_ATTEMPTS=5

# Duración del bloqueo tras superar intentos fallidos (minutos)
LOCKOUT_DURATION_MINUTES=15

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📝 LOGGING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Archivo de logs
LOG_FILE=logs/app.log

# Tamaño máximo de archivo de log antes de rotación (MB)
LOG_MAX_SIZE_MB=100

# Cantidad de backups de logs a mantener
LOG_BACKUP_COUNT=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ☁️ AZURE (Producción)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ID de Tenant de Azure AD
# AZURE_TENANT_ID=your-tenant-id

# ID de Cliente (App Registration)
# AZURE_CLIENT_ID=your-client-id

# Secreto del Cliente
# AZURE_CLIENT_SECRET=your-client-secret

# URL de Azure Key Vault para almacenar secretos
# KEYVAULT_URL=https://your-keyvault-name.vault.azure.net/
